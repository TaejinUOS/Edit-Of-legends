{
  "manifestVersion": 5,
  "id": "com.taejinuos.editoflegends",
  "name": "EditOfLegends",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.3.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["http://127.0.0.1:4317"] },
    "launchProcess": { "schemes": ["http"] }
  },
  "entrypoints": [
    {
      "id": "editoflegends",
      "type": "panel",
      "label": { "default": "EditOfLegends" },
      "minimumSize": { "width": 340, "height": 480 },
      "preferredDockedSize": { "width": 380, "height": 760 },
      "preferredFloatingSize": { "width": 420, "height": 800 }
    }
  ]
}
