{
  "manifestVersion": 5,
  "id": "com.taejinuos.editoflegends",
  "name": "EditOfLegends",
  "version": "0.2.2",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.3.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["http://localhost", "http://localhost:4317"] },
    "launchProcess": { "schemes": ["http", "editoflegends"] }
  },
  "entrypoints": [
    {
      "id": "editoflegends",
      "type": "panel",
      "label": { "default": "EditOfLegends" },
      "minimumSize": { "width": 300, "height": 360 },
      "preferredDockedSize": { "width": 340, "height": 560 },
      "preferredFloatingSize": { "width": 380, "height": 640 }
    }
  ]
}
